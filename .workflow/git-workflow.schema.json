{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git workflow payload structure, version 1",
  "description": "Structural schema only. Normative vocabulary and expressions live in the policy payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "scope",
    "acceptance",
    "workflow",
    "grammar",
    "traceability",
    "enforcement_design"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "grammar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dialect": {
          "type": "string",
          "minLength": 1
        },
        "issue_number": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "trunk": {
          "type": "string",
          "minLength": 1
        },
        "maintenance": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "topic_template": {
          "type": "string",
          "minLength": 1
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "dialect",
        "issue_number",
        "description",
        "trunk",
        "maintenance",
        "tag",
        "topic_template",
        "types"
      ]
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "enforcement_design": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
